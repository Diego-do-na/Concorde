# CONCORDE — /opt/concorde/.env on the Vultr instance.
# Admin access: ssh -p 2222 root@100.93.147.55 (Tailscale, private — never the judge's address).
# Judge endpoint: https://HOSTNAME/detect (product/deploy/DOMAIN.md); http://PUBLIC_IP is an emergency fallback only.
# Install: cp to /opt/concorde/.env, then: chown concorde:concorde /opt/concorde/.env && chmod 600 /opt/concorde/.env
# Loaded by systemd via EnvironmentFile= in deploy/concorde-api.service. NEVER commit the filled file.
# Every value below is a placeholder or a safe default; secrets are filled by hand on the server only.

# ---- core service (spec §18.2) ----
CONCORDE_BIND=127.0.0.1:8080                  # Caddy proxies :80/:443 -> this
CONCORDE_MODEL_PATH=/opt/concorde/artifacts/model.onnx
CONCORDE_FEATURE_CONTRACT=fc-1                # must equal the artifact's meta.json; mismatch aborts boot (FR-006)
CONCORDE_THRESHOLD=                           # empty = use the threshold from model.onnx.meta.json; set only to override
CONCORDE_MAX_BODY_BYTES=16777216              # 16 MB: measured max dataset body 11.7 MB base64, 4-min call 10.2 MB (replaces the spec's 32 MB)
CONCORDE_HANDLER_TIMEOUT_MS=20000             # fail-safe wall clock per /detect; the judge allows 30 s including network
CONCORDE_STRICT=0                             # 0 in production: never propagate errors, always 200 + fallback (ADR-006)

# ---- semantic layer (F-23) ----
CONCORDE_SEMANTIC_ENABLED=false               # keep false until the server-side ASR measurement passes the budget
CONCORDE_SEMANTIC_TIMEOUT_MS=1500             # hard timeout on /detect, measured from probe start (ADR-008, NFR-001)
CONCORDE_ANALYZE_SEMANTIC_TIMEOUT_MS=8000     # longer budget for /analyze (console only)
CONCORDE_SEMANTIC_FUSION_PATH=/opt/concorde/artifacts/semantic_fusion.json   # w + max_delta_p fitted offline
# local ASR (whisper.cpp via whisper-rs) — approved route: nothing leaves the server
CONCORDE_WHISPER_MODEL_PATH=/opt/concorde/artifacts/ggml-tiny.bin   # tiny or base: decided by the server benchmark (T057)
CONCORDE_PROBE_TEMPLATES_PATH=/opt/concorde/artifacts/probe_templates.json
CONCORDE_WHISPER_THREADS=2                    # = vCPU count; raise to 4 on vc2-4c-8gb
CONCORDE_ASR_MAX_CONCURRENT=1                 # semaphore: ASR jobs beyond this are skipped immediately (degraded), never queued

# ---- storage (COULD, ADR-007) — unset = storage disabled, /health reports "disabled" ----
# TIGERDATA_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# ---- observability ----
RUST_LOG=info,concorde_api=info
CONCORDE_LOG_FORMAT=json                      # structured JSON per request (NFR-008)
GIT_SHA=                                      # written by deploy/deploy.sh at deploy time; shown by /health and /version
