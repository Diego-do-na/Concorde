# CONCORDE API — systemd service unit file
# Location: /etc/systemd/system/concorde-api.service (on the Vultr instance)
# Installation:
#   1. Copy to /etc/systemd/system/concorde-api.service
#   2. systemctl daemon-reload
#   3. systemctl enable concorde-api
#   4. systemctl start concorde-api
# Verification:
#   systemctl status concorde-api
#   journalctl -u concorde-api -f
#
# Reference: SERVER.md (T003), DOMAIN.md (T054), spec §18.2 (environment vars)

[Unit]
Description=CONCORDE API Service — Voice Authenticity Detection
Documentation=https://github.com/altur-ai/concorde
PartOf=multi-user.target
After=network.target caddy.service
Wants=caddy.service

[Service]
# ---- User and directories ----
User=concorde
Group=concorde
WorkingDirectory=/opt/concorde

# ---- Environment ----
# Loaded from /opt/concorde/.env (template: product/deploy/env.server.template)
# Keys: CONCORDE_BIND, CONCORDE_MODEL_PATH, CONCORDE_FEATURE_CONTRACT, etc.
EnvironmentFile=/opt/concorde/.env

# ---- Process management ----
Type=simple
ExecStart=/opt/concorde/bin/concorde
StandardOutput=journal
StandardError=journal
SyslogIdentifier=concorde-api

# ---- Restart policy ----
Restart=always
RestartSec=2
# On-failure would retry only on exit code != 0; always restarts on any exit
# This is intentional: a crash is a crash.

# ---- Resource limits ----
# Memory: 2500M max (leaving room on vc2-2c-4gb: 3.8 GiB - 2.5 GiB = 1.3 GiB overhead for OS, Caddy, etc.)
# F-22 (interruption recovery) + acoustic features + semantic ASR can spike.
MemoryMax=2500M

# File descriptors: 65536 (per spec, for concurrent connections and file handles)
LimitNOFILE=65536

# ---- Hardening ----
# Standard sandboxing for a network service
PrivateTmp=yes
NoNewPrivileges=yes
# Caddy and the API are in the same data layer, so restrict filesystem access
# but allow read/write under /opt/concorde for log files and cache
ReadWritePaths=/opt/concorde

[Install]
WantedBy=multi-user.target
