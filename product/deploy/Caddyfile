# CONCORDE Caddyfile — reverse proxy with Let's Encrypt HTTPS
# Simplified for T024: primary API endpoints only
# Reference: product/deploy/DOMAIN.md, SERVER.md
#
# This configures:
# - Automatic Let's Encrypt HTTPS for getconcorde.tech
# - Reverse proxy to API service at 127.0.0.1:8080
# - IP-only HTTP fallback on :80
#
# Deploy: scp to /etc/caddy/Caddyfile, then: systemctl reload caddy

# ---- Primary HTTPS site ----
getconcorde.tech {
	# Automatic Let's Encrypt
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}

	# API endpoints
	reverse_proxy /detect 127.0.0.1:8080
	reverse_proxy /analyze 127.0.0.1:8080
	reverse_proxy /health 127.0.0.1:8080
	reverse_proxy /metrics 127.0.0.1:8080
	reverse_proxy /version 127.0.0.1:8080
	reverse_proxy /feed/* 127.0.0.1:8080
	reverse_proxy /ws 127.0.0.1:8080
	# Static console (React SPA) served from /opt/concorde/console
	# API routes above take precedence (exact matches like /detect, /analyze)
	handle_path /* {
		root * /opt/concorde/console
		try_files {path} /index.html
		file_server
	}
}

# ---- HTTP-only fallback (emergency only) ----
# Used only if HTTPS fails; never given to judge
:80 {
	reverse_proxy /detect 127.0.0.1:8080
	reverse_proxy /analyze 127.0.0.1:8080
	reverse_proxy /health 127.0.0.1:8080
	reverse_proxy /metrics 127.0.0.1:8080
	reverse_proxy /version 127.0.0.1:8080
}
