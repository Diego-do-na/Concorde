# CONCORDE — local development .env. Lives at product/.env (copy of this file); all commands (cargo, npm, python)
# run FROM product/, so every relative path below is relative to product/. .env must stay untracked
# (T001 adds .env and product/.env to the root .gitignore).
# The Rust service reads env vars only; from product/: `set -a; source .env; set +a`.

# ---- core service ----
CONCORDE_BIND=127.0.0.1:8080
CONCORDE_MODEL_PATH=api/tests/fixtures/dummy_fc1.onnx   # switch to artifacts/model.onnx once T021 lands
CONCORDE_FEATURE_CONTRACT=fc-1
CONCORDE_THRESHOLD=
CONCORDE_MAX_BODY_BYTES=16777216              # 16 MB: measured max dataset body 11.7 MB base64, 4-min call 10.2 MB
CONCORDE_HANDLER_TIMEOUT_MS=20000             # judge allows 30 s per call including network
CONCORDE_STRICT=1                             # 1 in dev/test: propagate errors instead of masking them (ADR-006)

# ---- semantic layer ----
CONCORDE_SEMANTIC_ENABLED=false
CONCORDE_SEMANTIC_TIMEOUT_MS=1500
CONCORDE_ANALYZE_SEMANTIC_TIMEOUT_MS=8000
CONCORDE_SEMANTIC_FUSION_PATH=artifacts/semantic_fusion.json
CONCORDE_PROBE_TEMPLATES_PATH=artifacts/probe_templates.json
CONCORDE_WHISPER_MODEL_PATH=ml/semantic/models/ggml-base.bin   # relative to product/; gitignored; download with ml/semantic/get_models.sh
CONCORDE_WHISPER_THREADS=4
CONCORDE_ASR_MAX_CONCURRENT=2

# ---- offline ML pipeline (never in the serving path) ----
CONCORDE_DATASET_DIR=/Users/diego/Desktop/Proyects/HackMty/hackmty26   # audio/, turns/, manifest.csv live here, never in the repo
CONCORDE_TRAIN_SEED=20260912

# ---- red-team clips (Néstor's laptop only) ----
# ELEVENLABS_API_KEY=                         # scope already decided: TTS, Speech to Speech, Voices Read, Models Access, User Access

# ---- storage (optional locally) ----
# TIGERDATA_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# ---- console (Vite reads only VITE_* at build time) ----
VITE_API_BASE=http://127.0.0.1:8080
VITE_USE_MOCKS=1                              # 1 = fixtures, no backend needed; 0 = hit VITE_API_BASE

# ---- observability ----
RUST_LOG=debug,concorde_api=debug,ort=warn
CONCORDE_LOG_FORMAT=pretty
