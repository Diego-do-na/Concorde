# Loaded only when Vite runs in `test` mode, i.e. by vitest.
#
# lib/api.ts builds request URLs as `${API_BASE}${path}`. API_BASE is empty in
# every real build, because Caddy serves the console and the API from a single
# origin (product/deploy/Caddyfile) and relative paths are correct there.
#
# Under jsdom that same relative path is fatal: Node's fetch and msw's
# interceptor both call `new URL("/analyze")` and throw "Invalid URL". Pointing
# API_BASE at the jsdom origin (pinned in vite.config.mts) makes the URLs
# absolute for tests only.
VITE_API_BASE=http://localhost:5173
